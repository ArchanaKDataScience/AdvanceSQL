'calculate the gap (in days) between each order and their previous order

WITH prev_orders AS (
    SELECT 
        customer_id,
        order_id,
        order_date,
        LAG(order_date, 1) OVER (
            PARTITION BY customer_id 
            ORDER BY order_date
        ) AS previous_order_date
    FROM orders
)
SELECT  
    customer_id,
    order_id,
    order_date,
    previous_order_date,
    DATEDIFF(day, previous_order_date, order_date) AS days_gap
FROM prev_orders;
