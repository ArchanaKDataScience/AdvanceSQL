WITH ordered_data AS (
    SELECT 
        customer_id,
        order_id,
        order_date,
        amount,
        LAG(amount) OVER (
            PARTITION BY customer_id 
            ORDER BY order_date
        ) AS prev_amount
    FROM orders
),
flagged AS (
    SELECT 
        customer_id,
        CASE 
            WHEN prev_amount IS NOT NULL AND amount <= prev_amount THEN 1
            ELSE 0
        END AS is_not_increasing
    FROM ordered_data
)
SELECT customer_id
FROM flagged
GROUP BY customer_id
HAVING SUM(is_not_increasing) = 0;
