WITH monthly_orders AS (
    SELECT DISTINCT
        customer_id,
        DATEFROMPARTS(YEAR(order_date), MONTH(order_date), 1) AS month_start
    FROM orders
),
lag_data AS (
    SELECT 
        customer_id,
        month_start,
        LAG(month_start) OVER (
            PARTITION BY customer_id 
            ORDER BY month_start
        ) AS prev_month
    FROM monthly_orders
)
SELECT 
    customer_id,
    month_start AS retained_month
FROM lag_data
WHERE DATEDIFF(month, prev_month, month_start) = 1;
